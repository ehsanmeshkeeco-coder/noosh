<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer water drop outline -->
    <path
        android:pathData="M 52,24 C 52,24 33,48 33,63 C 33,75 42,84 54,84 C 66,84 75,75 75,63 C 75,48 56,24 54,24 Z"
        android:strokeWidth="4"
        android:strokeColor="#2D9CFF"
        android:fillColor="#00000000" />

    <!-- Inner water fill with wave -->
    <path
        android:pathData="M 37,63 C 42,67 48,60 54,63 C 60,66 66,61 71,63 C 71,72 63,80 54,80 C 45,80 37,72 37,63 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="58"
                android:endX="54"
                android:endY="80"
                android:type="linear">
                <item android:color="#56B7FF" android:offset="0.0" />
                <item android:color="#2D9CFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Shiny reflection inside water -->
    <path
        android:pathData="M 42,68 C 41,71 44,75 48,76"
        android:strokeWidth="1.8"
        android:strokeColor="#8ED3FF"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Blue Heart on the top right -->
    <path
        android:pathData="M 76,32 C 74.5,29 70.5,29 69,31 C 67.5,29 63.5,29 62,32 C 60,35.5 65.5,40.5 69,43 C 72.5,40.5 78,35.5 76,32 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="62"
                android:startY="29"
                android:endX="76"
                android:endY="43"
                android:type="linear">
                <item android:color="#56B7FF" android:offset="0.0" />
                <item android:color="#2D9CFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
